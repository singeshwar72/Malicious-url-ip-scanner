# ============================================================
# Malicious URL & IP Scanner – Environment Variables Example
# Copy this file to .env and fill in your API keys.
# NEVER commit .env to version control.
# ============================================================

# Flask secret key (change this to a random string in production)
SECRET_KEY=change-me-to-a-random-secret

# Flask environment: development | production
FLASK_ENV=development
FLASK_DEBUG=1

# --- Optional External Reputation APIs ---
# Leave blank to use local-only analysis (application still works)

# VirusTotal (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# AbuseIPDB (https://www.abuseipdb.com/account/api)
ABUSEIPDB_API_KEY=

# IPinfo (https://ipinfo.io/account/token)
IPINFO_API_KEY=

# --- Rate limiting ---
# Max scan requests per minute per IP
RATE_LIMIT=30

# --- Database path (relative to project root) ---
DATABASE_PATH=scanner_data.db
